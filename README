Introduction to CMSSW: http://cms-sw.github.io

Instructions for running emulator:
- code from PR here: https://github.com/cms-sw/cmssw/pull/42964
- instructions for making plots from output ntuples: https://github.com/quinnanm/emulator_testing
- twiki instructions https://twiki.cern.ch/twiki/bin/view/CMSPublic/SWGuideL1TStage2Instructions
- run on lxplus8
- can change model version based on models available in the external repo here: https://github.com/cms-hls4ml/AXOL1TL/tree/main
    - change name of model in config file here:https://github.com/quinnanm/cmssw/blob/emulator_test/L1Trigger/L1TGlobal/python/simGtStage2Digis_cfi.py#L18

```
#setup according to twiki instructions

mkdir testemulator
cd testemulator

#follow instructions
cmsrel CMSSW_13_2_0_pre3
cd CMSSW_13_2_0_pre3/src
cmsenv
git cms-init

git cms-addpkg L1Trigger/L1TGlobal 

git remote add cms-l1t-offline git@github.com:cms-l1t-offline/cmssw.git
git fetch cms-l1t-offline l1t-integration-CMSSW_13_2_0_pre3
git cms-merge-topic -u cms-l1t-offline:l1t-integration-v164-CMSSW_13_2_0_pre3

git clone https://github.com/cms-l1t-offline/L1Trigger-L1TCalorimeter.git L1Trigger/L1TCalorimeter/data

scram b -j 8 

#checkout this branch
git checkout -b emulator_test
scram b -j 8 

#run file to produce ntuple
cmsenv
voms-proxy-init --voms cms

cmsDriver.py l1Ntuple -s L1REPACK:uGT,RAW2DIGI --python_filename=data_def.py -n 100 --no_output --era=Run3 --data --conditions=130X_dataRun3_Prompt_v4 --customise=L1Trigger/Configuration/customiseSettings.L1TSettingsToCaloParams_2023_v0_3 --customise=L1Trigger/Configuration/customiseUtils.L1TGlobalMenuXML --customise=L1Trigger/Configuration/customiseReEmul.L1TReEmulFromRAW --customise=L1Trigger/L1TNtuples/customiseL1Ntuple.L1NtupleRAWEMU --filein=/store/data/Run2023C/JetMET0/RAW/v1/000/368/566/00000/81c206fd-f1d4-4f09-905b-4a185cf097c2.root --fileout=L1Ntuple.root

#then copy file to wherever you need it
#pipe to file with >>L1Ntuple_info.txt

#get/change the xml library with for example
mkdir -p L1Trigger/L1TGlobal/data/Luminosity/startup/
cd L1Trigger/L1TGlobal/data/Luminosity/startup/
wget https://raw.githubusercontent.com/cms-l1-dpg/L1MenuRun3/master/development/L1Menu_Collisions2023_v1_3_0/L1Menu_Collisions2023_v1_3_0.xml
cd -

#changed name of xml file in L1Trigger/Configuration/python/customiseUtils.py
#actually  L1Menu_adt_topo_test_v2-d1.xml other one doesnt work!
scram b -j 8 
```
